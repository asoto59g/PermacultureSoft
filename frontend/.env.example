# Copiar a .env.local
#
# Vacío = mismo origen: Next.js redirige /api hacia FastAPI en :8000 mediante el
# rewrite de next.config.ts. Es lo que se quiere en desarrollo.
#
# En producción, si el backend de Python vive en otro host (Fly.io, Railway,
# Render, una VM), poner aquí su URL completa, sin barra final.
NEXT_PUBLIC_API_URL=
