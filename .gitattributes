# Normaliza a LF en el repositorio. Cada quien ve en su copia lo que su
# sistema use; el historial no se llena de cambios de fin de línea.
* text=auto eol=lf

# Los scripts de PowerShell necesitan CRLF en Windows.
*.ps1 text eol=crlf

# Scripts Unix: el shebang se rompe si Git los convierte a CRLF en Windows.
scripts/*.sh             text eol=lf
scripts/*.command        text eol=lf
scripts/*.py             text eol=lf
scripts/*.desktop        text eol=lf
*.desktop                text eol=lf
PermacultureSoft.command text eol=lf

# Binarios: que git no intente convertir nada.
*.png binary
*.ico binary
*.tif binary
*.tiff binary
